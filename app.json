{
  "expo": {
    "name": "SAM",
    "slug": "SAM",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/monochrome.png",
        "backgroundColor": "#FFFFFF",
        "monochromeImage": "./assets/brand/monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/brand/app-icon.png"
    },
    "scheme": "sam",
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
