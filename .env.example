# Public backend origin only; never place Pay2S credentials or bank encryption keys here.
# Set to use the real API adapter. Without it, existing preview data stays in mock mode.
EXPO_PUBLIC_API_URL=https://api.sam.pro.vn
# Native auth refresh Origin must be included in backend CORS_ALLOWED_ORIGINS.
# Web uses the browser Origin automatically.
EXPO_PUBLIC_AUTH_ORIGIN=https://sam.pro.vn
